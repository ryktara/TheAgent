{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "foundry": {
    "palette": "ember-kitchen",
    "typography": "inter-system",
    "style": "high-contrast-operational",
    "product_type": "restaurant-pos",
    "touch_min": 48,
    "operational": true,
    "tabular_numerals": true,
    "rtl": true,
    "text_roles": [
      "text",
      "text_muted",
      "primary_fg"
    ],
    "non_text_only": [
      "secondary",
      "accent",
      "border",
      "success",
      "warning"
    ],
    "themes": {
      "default": "ember-kitchen",
      "kds": "kds-dark"
    }
  },
