  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": "Inter",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
      },
      "body": {
        "$type": "fontFamily",
        "$value": "Inter",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
      },
      "arabic": {
        "$type": "fontFamily",
        "$value": "IBM Plex Sans Arabic",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
      },
      "urdu": {
        "$type": "fontFamily",
        "$value": "Noto Nastaliq Urdu",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
      }
    },
    "size": {
      "base": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "foundry": {
            "source": "scale base 16 ratio 1.2"
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "19px",
        "$extensions": {
          "foundry": {
            "source": "scale base 16 ratio 1.2"
          }
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "23px",
        "$extensions": {
          "foundry": {
            "source": "scale base 16 ratio 1.2"
          }
        }
      },
      "xl": {
