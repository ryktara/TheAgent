{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "foundry": {
    "palette": "retail-counter",
    "typography": "inter-system",
    "style": "high-contrast-operational",
    "product_type": "retail-pos",
    "touch_min": 48,
    "operational": true,
    "tabular_numerals": true,
    "rtl": true,
    "text_roles": [
      "text",
      "text_muted",
      "primary_fg"
    ],
    "non_text_only": [
      "primary",
      "secondary",
      "border",
      "success",
      "warning"
    ],
    "themes": {
      "default": "retail-counter",
      "colourblind": "retail-counter-cb"
    }
  },
