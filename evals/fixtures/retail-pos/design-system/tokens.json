        "$value": "28px",
        "$extensions": {
          "foundry": {
            "source": "scale base 16 ratio 1.2"
          }
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": "33px",
        "$extensions": {
          "foundry": {
            "source": "scale base 16 ratio 1.2"
