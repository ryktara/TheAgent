    "features": {
      "numerals": {
        "$type": "string",
        "$value": "tabular-nums",
        "$extensions": {
          "foundry": {
            "source": "ux-rules.csv:TYP-04"
          }
        }
      }
    }
  },
  "space": {
    "0": {
