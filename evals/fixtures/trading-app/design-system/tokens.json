{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "foundry": {
    "palette": "trading-dark-cb",
    "typography": "inter-system",
    "style": "fintech-dark",
    "product_type": "trading-app",
    "touch_min": 44,
    "operational": true,
    "tabular_numerals": true,
    "rtl": true,
    "text_roles": [
