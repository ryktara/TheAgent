      "$extensions": {
        "foundry": {
          "source": "styles.csv:fintech-dark"
        }
      }
    },
    "r1": {
      "$type": "dimension",
      "$value": "6px",
      "$extensions": {
        "foundry": {
          "source": "styles.csv:fintech-dark"
        }
      }
    },
    "r2": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "foundry": {
          "source": "styles.csv:fintech-dark"
        }
      }
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none"
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0,0,0,.08)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 4px 12px rgba(0,0,0,.12)"
    }
  },
  "z": {
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 10
    },
    "drawer": {
      "$value": 20
    },
    "dialog": {
      "$value": 30
    },
    "toast": {
      "$value": 40
    },
    "tooltip": {
      "$value": 50
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "100ms",
        "$extensions": {
          "foundry": {
            "source": "styles.csv:fintech-dark motion low"
          }
        }
      },
      "base": {
        "$type": "duration",
        "$value": "200ms",
        "$extensions": {
          "foundry": {
            "source": "styles.csv:fintech-dark motion low"
          }
        }
      },
      "slow": {
        "$type": "duration",
        "$value": "240ms",
        "$extensions": {
          "foundry": {
            "source": "styles.csv:fintech-dark motion low"
          }
        }
      }
    },
    "easing": {
      "standard": {
        "$value": "cubic-bezier(.2,0,0,1)"
      },
      "enter": {
        "$value": "cubic-bezier(0,0,0,1)"
      },
      "exit": {
        "$value": "cubic-bezier(.3,0,1,1)"
      }
    },
    "reduced": {
      "$value": "transition-duration: 1ms; animation: none",
      "$extensions": {
        "foundry": {
          "source": "ux-rules.csv:MOT-03"
        }
      }
    }
  },
  "touch": {
    "min": {
      "$type": "dimension",
      "$value": "44px",
      "$extensions": {
        "foundry": {
          "source": "ui_profile.touch 44dp"
        }
      }
    }
  }
