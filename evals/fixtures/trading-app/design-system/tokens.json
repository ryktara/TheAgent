        "$type": "fontFamily",
        "$value": "Inter",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
      },
      "body": {
        "$type": "fontFamily",
        "$value": "Inter",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono",
        "$extensions": {
          "foundry": {
            "source": "typography.csv:inter-system"
          }
        }
