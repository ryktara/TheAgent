{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.dev/schemas/adr.schema.json",
  "title": "Foundry ADR frontmatter (.foundry/adr/NNNN-*.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "decision_refs"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{4}$" },
    "title": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "enum": ["accepted", "superseded", "proposed"] },
    "decision_refs": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "string" },
    "date": { "type": "string" }
  }
}
