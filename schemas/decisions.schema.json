{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.dev/schemas/decisions.schema.json",
  "title": "Foundry decision ledger (.foundry/decisions.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "mode", "budget", "decisions"],
  "properties": {
    "pack": { "type": "string" },
    "mode": { "type": "string", "enum": ["attended", "unattended"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round1_max", "round2_max", "round1_used", "round2_used"],
      "properties": {
        "round1_max": { "type": "integer", "const": 7 },
        "round2_max": { "type": "integer", "const": 3 },
        "round1_used": { "type": "integer", "minimum": 0, "maximum": 7 },
        "round2_used": { "type": "integer", "minimum": 0, "maximum": 3 },
        "timeout_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "flags": { "type": "array", "items": { "type": "string" } },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "value", "source", "reversible"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "value": {},
          "source": { "type": "string", "enum": ["pack-default", "human", "timeout-default", "brief", "agent-fact"] },
          "reversible": { "type": "boolean" },
          "rationale": { "type": "string" },
          "round": { "type": "integer", "minimum": 0, "maximum": 2 },
          "asked_at": { "type": "string" },
          "maps_to": { "type": "string" }
        }
      }
    }
  }
}
