{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.dev/schemas/domain.schema.json",
  "title": "Foundry domain model (.foundry/domain.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "contexts", "entities", "events"],
  "properties": {
    "pack": { "type": "string" },
    "decisions_hash": { "type": "string" },
    "contexts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fields", "states", "transitions", "invariants", "owned_by"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "fields": { "type": "array", "items": { "type": "string" } },
          "states": { "type": "array", "items": { "type": "string" } },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "by"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "by": { "type": "string", "minLength": 1 },
                "guard": { "type": "string" }
              }
            }
          },
          "invariants": { "type": "array", "items": { "type": "string" } },
          "owned_by": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "producer", "consumers"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "entity": { "type": "string" },
          "transition": { "type": "string" },
          "producer": { "type": "string" },
          "consumers": { "type": "array", "items": { "type": "string" } },
          "external": { "type": "boolean" }
        }
      }
    }
  }
}
