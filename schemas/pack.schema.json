{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.dev/schemas/pack.schema.json",
  "title": "Foundry domain pack (pack.yaml) v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "slug",
    "name",
    "aliases",
    "confidence_keywords",
    "personas",
    "jobs",
    "must_have",
    "should_have",
    "entities",
    "invariants",
    "integrations",
    "regional",
    "compliance_must",
    "nfr_defaults",
    "stack_default",
    "ui_profile",
    "questions",
    "reference"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence_keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "must",
          "screens"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "must": {
            "type": "boolean"
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "persona": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "extra_readers": {
            "type": "array",
            "description": "1.8: roles that may list/get this job's entity beyond the persona and admin; objects may scope to states",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "role"
                  ],
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "merge_into": {
            "type": "string",
            "description": "1.8: this job is delivered by the named job's ticket (same screen); no own ticket"
          }
        }
      }
    },
    "must_have": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "should_have": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exposure": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "derived"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "regional": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "compliance_must": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compliance_should": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tax_by_province": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "rate",
                "digital_rate",
                "authority",
                "as_of"
              ]
            }
          }
        }
      }
    },
    "compliance_must": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nfr_defaults": {
      "type": "object"
    },
    "stack_default": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ui_profile": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "string"
        },
        "typography": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "themes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rank",
          "ask",
          "answer_type",
          "default"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "ask": {
            "type": "string"
          },
          "answer_type": {
            "type": "string",
            "enum": [
              "choice",
              "text",
              "number",
              "bool"
            ]
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "reversible": {
            "type": "boolean"
          },
          "skip_if_brief_mentions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brief_hints": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "maps_to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "followups": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "when",
                "ask"
              ],
              "additionalProperties": false,
              "properties": {
                "when": {},
                "ask": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "derive_from": {
            "type": "object",
            "required": [
              "question",
              "map"
            ],
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string"
              },
              "map": {
                "type": "object"
              }
            }
          },
          "enables": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "screens",
        "workflows",
        "glossary",
        "compliance",
        "ux_patterns"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "screens": {
          "type": "string"
        },
        "workflows": {
          "type": "string"
        },
        "glossary": {
          "type": "string"
        },
        "compliance": {
          "type": "string"
        },
        "ux_patterns": {
          "type": "string"
        }
      }
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "complete": {
      "type": "boolean"
    },
    "compliance_should": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regulated": {
      "type": "boolean",
      "description": "1.9: the domain needs a licence or regulator registration before go-live. Forces the regulator-licence wizard at phase 10 and blocks `gate release` until a human runs `foundry.py release confirm --by <name>`."
    },
    "contexts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "1.9: bounded contexts → entity names. Replaces the core defaults (operations, fulfilment, payments, catalog, inventory, people, reporting, sync) for domain.yaml, api paths and ticket files."
    },
    "offline_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "1.9: contexts whose entities and jobs are offline-capable (outbox + sync); empty or absent with offline: forbidden means none."
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "description": "2.0: domain words the pack-agnostic core reads instead of hard-coded prose. Every key is optional; complete packs must carry the block. See packs/README.md.",
      "properties": {
        "scaffold_ticket_titles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auth": {
              "type": "string"
            },
            "tenancy": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            },
            "tokens": {
              "type": "string"
            },
            "offline": {
              "type": "string"
            }
          },
          "description": "titles of T-001..T-005 (offline only when the pack has offline contexts)"
        },
        "adr_hints": {
          "type": "object",
          "additionalProperties": false,
          "description": "1-2 sentences of domain context per ADR id, woven into the ADR Context section",
          "properties": {
            "0001": {
              "type": "string"
            },
            "0002": {
              "type": "string"
            },
            "0003": {
              "type": "string"
            },
            "0004": {
              "type": "string"
            },
            "0005": {
              "type": "string"
            },
            "0006": {
              "type": "string"
            },
            "0007": {
              "type": "string"
            },
            "0008": {
              "type": "string"
            },
            "0009": {
              "type": "string"
            }
          }
        },
        "design_defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key_screens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "component_set": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "theme_names": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "screen_types": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "screen id → copy.csv screen type (state.<state>.<type>)"
            },
            "screen_components": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": "screen id → component ids always on that screen"
            },
            "component_hints": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "screens.md word → component id"
            },
            "keyboard": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "description": "screen id → {key: action}"
            },
            "list_routes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "what the design and screens skeletons pick instead of core defaults"
        },
        "glossary_hint_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "copy_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": "copy id → {en, ar, ur}; wins over data/copy.csv and reference/copy.csv"
        },
        "money_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "substrings of job ids that mark money-moving operations in the threat model and tickets"
        },
        "operator_role": {
          "type": "string",
          "description": "front-line persona named in user docs file names and tests (generic: operator)"
        },
        "authz_guard": {
          "type": "string",
          "description": "tail of x-foundry.authz on job operations (generic: step-up approval when the job guards it)"
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tech",
              "does",
              "talks_to"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "tech": {
                "type": "string"
              },
              "does": {
                "type": "string"
              },
              "talks_to": {
                "type": "string"
              }
            }
          },
          "description": "architecture.md container rows; tech is a stack_default key or `stack` for the chosen web stack"
        },
        "adr_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "ADR id → extra decision ids cited in that ADR"
        },
        "user_docs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buttons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "quick_start_title_en": {
              "type": "string"
            },
            "quick_start_title_ar": {
              "type": "string"
            },
            "approval_note": {
              "type": "string"
            },
            "routine": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "route": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "seed_note": {
          "type": "string"
        },
        "event_consumers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "consumer context → {from: producer context, states: [...]} extra event consumers"
        },
        "terms": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "core noun phrases by key (catalog, catalog_items, canvas, live_state); each has a generic fallback"
        }
      }
    }
  }
}
